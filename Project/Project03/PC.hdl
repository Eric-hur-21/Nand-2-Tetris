// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    //// Built it with register 
    Inc16(in=regOut, out=incOut);

    // Three conditionals
    Mux16(a=regOut, b=incOut, sel=inc, out=aftterInc);
    Mux16(a=aftterInc, b=in, sel=load, out=afterLoad);
    Mux16(a=afterLoad, b=false, sel=reset, out=afterReset);

    Register(in=afterReset, load=true, out=regOut, out=out);

}